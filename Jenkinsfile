pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out e-commerce application'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing e-commerce application'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying e-commerce application'
            }
        }
    }
}